# Load explicitly: python run_server.py --env-file .env
RAG_DB=data/rag.sqlite3
RAG_AUTH_FILE=data/demo_auth.json
RAG_GENERATOR=extractive
RAG_PLANNER=offline
# Real services are opt-in; use only synthetic/public documents.
RAG_MODEL_URL=https://replace-with-provider/v1
RAG_MODEL_KEY=replace_me
RAG_MODEL_NAME=replace_me
RAG_EMBEDDING=hash
RAG_EMBED_URL=https://replace-with-provider/v1
RAG_EMBED_KEY=replace_me
RAG_EMBED_MODEL=replace_me
RAG_EMBED_DIM=1024
# RAG_PG_DSN=postgresql://rag:local-demo-only@127.0.0.1:5433/rag

# Optional tracing: set all three values before enabling; no prompts are exported.
RAG_TRACING=off
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# LangGraph always orchestrates /agent. --real enables the LangChain model planner.
# Direct environment config may use RAG_PLANNER=langchain and RAG_SYNTHESIS=real.
RAG_SYNTHESIS=offline
# Optional PG: uncomment RAG_STORE and set RAG_PG_DSN above.
# RAG_STORE=postgresql
RAG_PG_SCHEMA=rag_v4
# Attempt budgets count failed requests too; no automatic reset.
RAG_BUDGET_DB=data/request_budget.sqlite3
RAG_CHAT_ATTEMPT_LIMIT=9
RAG_EMBEDDING_ATTEMPT_LIMIT=12
RAG_RERANK_ATTEMPT_LIMIT=30
# RAG_RERANKER: off | cross-encoder | http
RAG_RERANKER=off
# Install requirements-ml.txt before using a local model path or model ID.
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=cpu
# RAG_RERANK_REVISION=replace_with_model_revision
# HTTP mode expects POST {RAG_RERANK_URL}/rerank with indexed scores.
# RAG_RERANK_URL=https://your-compatible-reranker/v1
# RAG_RERANK_KEY=replace_me

# v4.1 evidence screening; model mode requires an explicit persistent budget.
RAG_EVIDENCE_MODE=lexical
RAG_EVIDENCE_MIN_COVERAGE=0.45
RAG_EVIDENCE_ATTEMPT_LIMIT=30
# RAG_EVIDENCE_MODEL=your-compatible-judge-model
# Private platform credentials (generate with init_platform_auth.py):
# RAG_PLATFORM_AUTH_FILE=data/platform_auth.json
RAG_PLATFORM_METHOD=bm25
RAG_PLATFORM_RERANK=off
# Live probes. Keep real credentials only in local configuration files.
# RAG_VERIFY_APP_URL=http://127.0.0.1:8006
# RAG_VERIFY_APP_TOKEN=your-local-user-token
# DIFY_API_BASE_URL=https://your-dify-host/v1
# DIFY_API_KEY=your-dify-application-key
# DIFY_VERIFY_INPUTS={"query":"差旅报销的规定是什么？"}
# COZE_API_BASE_URL=https://api.coze.cn
# COZE_API_TOKEN=your-coze-access-token
# COZE_WORKFLOW_ID=your-published-workflow-id
# COZE_VERIFY_PARAMETERS={"query":"差旅报销的规定是什么？"}
# RAG_EVAL_TOKEN=your-local-user-token

# Lightweight showcase features; no additional external service required.
RAG_CORRECTIVE=on
RAG_SECTION_CONTEXT=on
