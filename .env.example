# This project does not auto-load a .env file. Set environment variables explicitly.
RAG_DB=data/rag.sqlite3
RAG_AUTH_FILE=data/demo_auth.json
RAG_GENERATOR=extractive
RAG_PLANNER=offline
# Real services are opt-in; use only synthetic/public documents.
RAG_MODEL_URL=https://replace-with-provider/v1
RAG_MODEL_KEY=replace_me
RAG_MODEL_NAME=replace_me
RAG_EMBEDDING=hash
RAG_EMBED_URL=https://replace-with-provider/v1
RAG_EMBED_KEY=replace_me
RAG_EMBED_MODEL=replace_me
RAG_EMBED_DIM=1024
# RAG_PG_DSN=postgresql://rag:local-demo-only@127.0.0.1:5433/rag

# Optional tracing: set all three values before enabling; no prompts are exported.
RAG_TRACING=off
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
